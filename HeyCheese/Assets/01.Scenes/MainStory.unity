  m_Text: "\U0001F4E2 \uD29C\uD1A0\uB9AC\uC5BC\n\uAC8C\uC784\uC744 \uC9C4\uD589\uD558\uBA70\n\uC5EC\uB7EC\uBD84\uC740
    \uB2E4\uC591\uD55C \uC0C1\uD669\uC5D0\uC11C\n\uC5BC\uAD74 \uD45C\uC815\uC744
    \uC9C0\uC5B4\uC57C \uD569\uB2C8\uB2E4.\n\n\n\uD654\uBA74 \uC911\uC559\uC5D0 \uC5BC\uAD74\uC744
    \uB9DE\uCDB0\uC8FC\uC138\uC694.\n\uB300\uC0AC\uB294 \uD654\uBA74\uC744 \uD130\uCE58\uD558\uC5EC
    \uB118\uAE38 \uC218 \uC788\uC5B4\uC694.\n\uC815\uD655\uD55C \uD45C\uC815\uC744
    \uC9C0\uC5B4\uBCF4\uC138\uC694.\n.\n.\n\n\n\"\uADF8\uB7FC, \uC774\uC81C \uC2DC\uC791\uD574\uBCFC\uAE4C\uC694?\""
